{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r formatted_file; [ -n \"$formatted_file\" ] && \"$CLAUDE_PROJECT_DIR\"/scripts/format.sh \"$formatted_file\"; } 2>/dev/null || true",
            "statusMessage": "Formatting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/fix.sh 2>/dev/null || true",
            "statusMessage": "Formatting and syncing HOUSEKEEPING.md"
          }
        ]
      }
    ]
  }
}
