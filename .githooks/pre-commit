#!/usr/bin/env bash
# Syncs HOUSEKEEPING.md and formats the staged files, then stages the results.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [[ ! -d node_modules ]]; then
  echo "pre-commit: dependencies are missing - run 'npm run setup'" >&2
  exit 1
fi

./scripts/sync-housekeeping.sh
./scripts/sync-schema.sh

shopt -s nullglob
# Stage only the copies git tracks, because git add fails on a path the .gitignore covers.
housekeeping_files=()
for housekeeping_file in skills/*/HOUSEKEEPING.md; do
  git check-ignore -q "$housekeeping_file" || housekeeping_files+=("$housekeeping_file")
done
if [[ ${#housekeeping_files[@]} -gt 0 ]]; then
  git add -- "${housekeeping_files[@]}"
fi

staged_files=()
while IFS= read -r staged_file; do
  [[ -f "$staged_file" ]] && staged_files+=("$staged_file")
done < <(git diff --cached --name-only --diff-filter=ACMR)

[[ ${#staged_files[@]} -gt 0 ]] || exit 0

./scripts/format.sh "${staged_files[@]}"

git add -- "${staged_files[@]}"
