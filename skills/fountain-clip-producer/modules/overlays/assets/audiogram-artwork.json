      "size": 48,
      "position": "top-center",
      "marginV": 1000,
      "start": 0,
      "end": null,
      "fadeInMs": 0,
      "fadeOutMs": 0
    },
    {
      "type": "audiogram",
      "width": 900,
      "height": 140,
      "color": "#FFFFFFE6",
      "waveMode": "filled",
      "position": "bottom-center",
      "marginV": 560
    },
    { "type": "progressBar", "height": 12, "color": "#FFFFFFD9" }
  ]
}
