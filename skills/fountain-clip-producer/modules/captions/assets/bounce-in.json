{
  "name": "bounce-in",
  "description": "One rounded word at a time, rising from below with an overshoot settle. Softer energy than word-pop, and the friendliest style here.",
  "font": {
    "family": "Poppins",
    "size": 80,
    "bold": true,
    "case": "verbatim"
  },
  "colors": {
    "primary": "#FFFFFF",
    "highlight": "#3DFFC0",
    "outline": "#06231C"
  },
  "border": {
    "style": "outline",
    "outline": 5,
    "shadow": 0
  },
  "animation": {
    "type": "bounce-in",
    "appearMs": 150,
    "settleMs": 120,
    "overshootPct": 110,
    "riseHeight": 130
  }
}
